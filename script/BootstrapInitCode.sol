pragma solidity ^0.8.34;

/**
 * @dev The exact creation code of each fixed-address bootstrap, pinned rather than compiled. Solc
 *      appends a hash of every source file's exact text to the bytecode, so rebuilding from a tree that
 *      differs only in a comment yields a different CREATE2 address - and these addresses are compiled
 *      into every vault (the vault bootstrap fixes each owner's vault address, the forwarder and the
 *      factory proxies are born on the other two). The guard's live bootstrap was lost exactly this
 *      way; its bytes had to be recovered from chain.
 *
 *      Only the metadata is frozen: `test/local/BootstrapPin.t.sol` holds the code itself to the
 *      source, with the metadata stripped. A change to what a bootstrap DOES fails there, and needs a
 *      deliberate new pin and new addresses.
 */

/**
 *  @dev {BittyV1VaultBootstrap}, at {BITTY_VAULT_BOOTSTRAP}. Live on mainnet, Base, Sepolia and Robinhood.
 */
bytes constant VAULT_BOOTSTRAP_INITCODE =
    hex"";

/**
 *  @dev {BittyV1VaultFactoryBootstrap}, at {BITTY_VAULT_FACTORY_BOOTSTRAP}.
 */
bytes constant VAULT_FACTORY_BOOTSTRAP_INITCODE =
    hex"";

/**
 *  @dev {BittyV1ForwarderBootstrap}, at {FORWARDER_BOOTSTRAP}; the forwarder proxy is born on it.
 */
bytes constant FORWARDER_BOOTSTRAP_INITCODE =
    hex"";

/**
 *  @dev The salt-0 CREATE2 address of {FORWARDER_BOOTSTRAP_INITCODE}.
 */
address constant FORWARDER_BOOTSTRAP = 0x61917bA82fEda294889afe366c0c646C7C5f77Ca;
